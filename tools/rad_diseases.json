{
  "plugin": "RadSurvival.esp",
  "summary": "Disease layer contract: two illnesses, three stages each, plus the risk and state GLOBs the HUD reads. Tuning and record expectations only - FO4IDE authors the records and tests/verify_survival.py checks the shipped plugin against this file.",
  "mgefDefaults": {
    "archetype": 34,
    "archetypeName": "Peak Value Modifier",
    "castingType": 0,
    "castingTypeName": "Constant Effect",
    "delivery": 0,
    "flags": 2562,
    "flagsMeaning": "Recover | No Duration | No Area",
    "castingSoundLevel": 1,
    "dualCastingScale": 1.0
  },
  "spellDefaults": {
    "type": 4,
    "typeName": "Ability",
    "castType": 0,
    "castTypeName": "Constant Effect",
    "targetType": 0,
    "targetTypeName": "Self"
  },
  "risk": {
    "globEditorId": "RadSurvival_Risk",
    "globFormId": "0x01000822",
    "range": "0..1 exposure pool"
  },
  "state": {
    "globEditorId": "RadSurvival_Disease",
    "globFormId": "0x01000823",
    "encoding": "DiseaseId * 10 + DiseaseStage, 0 while healthy; stage 0 means incubating"
  },
  "timing": {
    "hourlyRisk": 0.012,
    "riskPerWeakStage": 0.008,
    "riskPerHit": 0.01,
    "riskPerSwim": 0.03,
    "riskPerRadHour": 0.08,
    "riskPerRainHour": 0.02,
    "swimIntervalGameDays": 0.1,
    "hitCooldownSeconds": 2.0,
    "incubationHours": 4.0,
    "stage2Hours": 10.0,
    "stage3Hours": 24.0,
    "restCureBaseHours": 4.0,
    "immunityHours": 24.0
  },
  "exposure": {
    "hit": "a weapon or creature hit from another actor; one charge per 2 real seconds so an automatic burst cannot flood the pool",
    "swim": "one charge per 0.1 game days of swimming, mirroring vanilla HC_ManagerScript",
    "ignored": "self-inflicted hits, hits with no actor aggressor, and spell sources such as radiation cloaks",
    "radWeather": "the sky is sampled on the pool tick while the player is outdoors: a weather in the rad set charges the whole elapsed interval at riskPerRadHour",
    "rain": "any other weather whose classification is rain or snow charges the interval at riskPerRainHour; interiors and covers are excluded by IsInInterior"
  },
  "weather": {
    "stormWeatherPlugin": "RadiationOverhaul.esp",
    "stormWeatherBase": "0x840",
    "stormWeatherBaseDecimal": 2112,
    "stormWeatherCount": 5,
    "vanillaRadStorm": "0x1C3D5E:Fallout4.esm",
    "vanillaRadStormDecimal": 1850718,
    "rainClassification": 2,
    "resolution": "resolved with GetFormFromFile by plugin name; RadSurvival.esp keeps Fallout4.esm as its only master, so these forms cannot be bound as VMAD properties"
  },
  "taint": {
